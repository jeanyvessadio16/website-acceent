# Base de données PostgreSQL (Supabase Pooler & Connexion directe Prisma)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-1-eu-west-3.pooler.supabase.com:5432/postgres"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"
PG_POOL_MAX=10

# Sécurité & Sessions JWT (générer une chaîne aléatoire >= 32 caractères)
SESSION_SECRET="remplacer-par-une-cle-aleatoire-d-au-moins-32-caracteres"

# URL canonique publique du site
NEXT_PUBLIC_SITE_URL="https://acceent.org"

# Supabase Storage
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
NEXT_PUBLIC_SUPABASE_DOCS_BUCKET="documents"

# Formulaire de contact (Web3Forms)
WEB3FORMS_ACCESS_KEY=""

# Envoi d'e-mails transactionnels & Newsletter (Resend) — optionnel en local
RESEND_API_KEY=""
EMAIL_FROM="ACCEENT <no-reply@acceent.org>"

# Analytics & SEO — optionnels
NEXT_PUBLIC_GA_ID="G-LHX5D4CQ9T"
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
